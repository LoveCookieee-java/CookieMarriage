<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for MarriageCraft plugin.

  Whitelists known false positives that arise from the Bukkit/Paper
  plugin architecture. Each exclusion is documented with a rationale.
-->
<FindBugsFilter>

    <!--
      EI_EXPOSE_REP2: Storing reference to externally mutable object.
      In a Bukkit plugin, the JavaPlugin instance and the Vault Economy
      object are singletons managed by the server. Storing them by
      reference is the idiomatic and required pattern. Defensive copying
      is not possible (these are interfaces / final classes we don't own).
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      EI_EXPOSE_REP: Returning reference to mutable object (getInstance()).
      The singleton getter follows the Bukkit plugin convention and is
      only accessed by code within this plugin.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="dev.marriage.MarriagePlugin"/>
    </Match>

    <!--
      MS_EXPOSE_REP: Static method returning mutable plugin instance.
      Same rationale as EI_EXPOSE_REP above.
    -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="dev.marriage.MarriagePlugin"/>
    </Match>

    <!--
      UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR: Fields initialised in onEnable().
      JavaPlugin subclasses are not constructed by user code; fields are
      intentionally initialised in onEnable() after the plugin framework
      is ready. A null check in getMsg() guards against premature access.
    -->
    <Match>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
        <Class name="dev.marriage.MarriagePlugin"/>
    </Match>

    <!--
      RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE: Redundant null check in setupEconomy().
      SpotBugs infers economy is non-null after the assignment, but the explicit
      null check defends against economy providers that return null (allowed by
      the Vault API contract).
    -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
        <Class name="dev.marriage.MarriagePlugin"/>
    </Match>

    <!--
      SF_SWITCH_FALLTHROUGH: Java 21 pattern matching switch expressions
      trigger false positives in older SpotBugs detectors.
    -->
    <Match>
        <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
    </Match>

    <!--
      SE_BAD_FIELD_INNER_CLASS: BukkitRunnable anonymous classes.
      These are never serialized; the warning is a false positive.
    -->
    <Match>
        <Bug pattern="SE_BAD_FIELD_INNER_CLASS"/>
    </Match>

    <!--
      EI_EXPOSE_REP: DatabaseManager.getConnection() and getCoupleRepository().
      These return references to internal objects intentionally.
      The connection and repository are owned and managed by DatabaseManager;
      callers must use them (not copy them). This is a standard repository pattern.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="dev.marriage.database.DatabaseManager"/>
    </Match>

    <!--
      ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD: Writing MarriagePlugin.instance in
      onEnable() / onDisable(). This is the canonical Bukkit singleton pattern;
      only one plugin instance exists per classloader, so the write is safe.
    -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        <Class name="dev.marriage.MarriagePlugin"/>
    </Match>

</FindBugsFilter>
